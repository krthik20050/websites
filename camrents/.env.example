# Database (Neon PostgreSQL - Mumbai region)
DATABASE_URL=postgresql://user:pass@ep-example-1234.us-east-2.aws.neon.tech/camrents?sslmode=require

# Auth (Next.js)
AUTH_SECRET=your-secret-here

# Razorpay (India payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# WhatsApp (Meta Cloud API)
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...

# SMS (Fast2SMS)
SMS_API_KEY=...
SMS_SENDER_ID=CAMRENT

# Email (Resend)
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SHOP_NAME="CamRents Thrissur"
SHOP_PHONE=+919999999999
SHOP_ADDRESS="[Address], Thrissur, Kerala"
